@echo off
rem ---------------------------------------------------------------------------
rem  {{NAME}} - launcher generated by PythonPortableBuilder {{TOOLKIT_VERSION}}
rem  Runs the application with the bundled Python runtime (runtime\{{PYTHON_EXE}}).
rem  No system Python, pip, PATH or registry changes are used or required.
rem  All paths are resolved relative to this file. Arguments are forwarded
rem  unchanged and the application's exit code is returned.
rem ---------------------------------------------------------------------------
setlocal DisableDelayedExpansion
set "PPB_ROOT=%~dp0"
set "PPB_ROOT=%PPB_ROOT:~0,-1%"
set "PPB_CALLER_CWD=%CD%"
set "PPB_PY=%PPB_ROOT%\runtime\{{PYTHON_EXE}}"
if not exist "%PPB_PY%" goto :missing_runtime
if not exist "%PPB_ROOT%\launcher\ppb_launch.py" goto :missing_launcher
set "PPB_WORKDIR={{WORKING_DIRECTORY}}"
if /I "%PPB_WORKDIR%"=="app" pushd "%PPB_ROOT%\app"
"%PPB_PY%" "%PPB_ROOT%\launcher\ppb_launch.py" %*
set "PPB_EXIT=%ERRORLEVEL%"
if /I "%PPB_WORKDIR%"=="app" popd
endlocal & exit /b %PPB_EXIT%

:missing_runtime
echo [{{NAME}}] Bundled Python runtime not found: "%PPB_PY%" 1>&2
endlocal & exit /b 9009

:missing_launcher
echo [{{NAME}}] Launcher not found: "%PPB_ROOT%\launcher\ppb_launch.py" 1>&2
endlocal & exit /b 9009
