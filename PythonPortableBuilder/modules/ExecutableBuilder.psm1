#Requires -Version 5.1
<#
    ExecutableBuilder.psm1 - Option A: PyInstaller standalone executables.

      * Stages a filtered copy of the project (the source is never touched)
      * Creates an isolated virtual environment with the project dependencies + PyInstaller
      * Generates a .spec file (kept in <package>\pyinstaller\) or uses a custom one
      * Builds onefile or onedir, captures PyInstaller warnings
#>

Set-StrictMode -Version 2.0
Import-Module (Join-Path $PSScriptRoot 'Common.psm1') -DisableNameChecking
Import-Module (Join-Path $PSScriptRoot 'PythonRuntimeManager.psm1') -DisableNameChecking
Import-Module (Join-Path $PSScriptRoot 'DependencyManager.psm1') -DisableNameChecking
Import-Module (Join-Path $PSScriptRoot 'ResourceManager.psm1') -DisableNameChecking

function ConvertTo-PpbPyLiteral {
    param([AllowNull()][AllowEmptyString()][string]$Value)
    if ($null -eq $Value) { return 'None' }
    $escaped = $Value.Replace('\', '\\').Replace("'", "\'")
    return "'$escaped'"
}

function ConvertTo-PpbPyList {
    param([AllowNull()][object[]]$Values, [int]$Indent = 4)
    if (-not $Values -or $Values.Count -eq 0) { return '[]' }
    $pad = ' ' * $Indent
    return "[`n" + (($Values | ForEach-Object { "$pad$_," }) -join "`n") + "`n]"
}

<#
.SYNOPSIS
    Computes (source-relative-to-stage, bundle-destination-dir) pairs for resource files.
.DESCRIPTION
    Resources are placed relative to the import root that contains them, so code that
    locates files relative to its own module (__file__) finds them inside the bundle.
#>
function Get-PpbBundleDataMap {
    param([Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Resources, [Parameter(Mandatory)][string[]]$ImportRoots)
    $roots = @($ImportRoots | Where-Object { $_ -and $_ -ne '.' } | ForEach-Object { $_.Replace('\', '/').Trim('/') + '/' })
    $map = @()
    foreach ($r in $Resources) {
        $rel = $r.Replace('\', '/')
        $bundlePath = $rel
        foreach ($root in $roots) {
            if ($rel.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) { $bundlePath = $rel.Substring($root.Length); break }
        }
        $destDir = ($bundlePath -replace '/[^/]+$', '')
        if ($destDir -eq $bundlePath) { $destDir = '.' }
        $map += [pscustomobject]@{ Source = $rel; DestinationDir = $destDir; BundlePath = $bundlePath }
    }
    return $map
}

<#
.SYNOPSIS
    Writes the bootstrap script used for module/callable entry points.
#>
function New-PpbEntryBootstrap {
    param([Parameter(Mandatory)]$Entry, [Parameter(Mandatory)][string]$Path, [switch]$FreezeSupport)
    $lines = @('# Generated by PythonPortableBuilder: entry-point bootstrap for PyInstaller.', 'import sys')
    if ($FreezeSupport) { $lines += @('import multiprocessing', 'multiprocessing.freeze_support()') }
    if ($Entry.kind -eq 'module') {
        $lines += @("import $($Entry.module)  # static import so PyInstaller collects the package", 'import runpy',
            "runpy.run_module($(ConvertTo-PpbPyLiteral $Entry.module), run_name='__main__', alter_sys=True)")
    } else {
        $lines += @("import $($Entry.module) as _ppb_target", '_ppb_obj = _ppb_target')
        foreach ($attr in ([string]$Entry.function).Split('.')) { $lines += "_ppb_obj = getattr(_ppb_obj, $(ConvertTo-PpbPyLiteral $attr))" }
        $lines += @('if __name__ == "__main__":', '    sys.exit(_ppb_obj())')
    }
    Write-PpbTextFile -Path $Path -Content (($lines -join "`n") + "`n")
}

<#
.SYNOPSIS
    Generates the PyInstaller spec file. All paths are relative to SPECPATH.
#>
function New-PpbPyInstallerSpec {
    param(
        [Parameter(Mandatory)][hashtable]$Context,
        [Parameter(Mandatory)][string]$SpecPath,
        [Parameter(Mandatory)][string]$StageAppDir,
        [Parameter(Mandatory)][string]$ScriptPath,
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$DataMap,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$HiddenImports,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$PathEx,
        [AllowEmptyCollection()][string[]]$MetadataDistributions = @(),
        [AllowEmptyCollection()][string[]]$CollectPackages = @(),
        [string]$IconFile
    )
    $specDir = Split-Path -Parent $SpecPath
    $relStage = (Get-PpbRelativePathAny -Path $StageAppDir -BasePath $specDir)
    $relScript = (Get-PpbRelativePathAny -Path $ScriptPath -BasePath $specDir)
    $datas = @($DataMap | ForEach-Object { "(P($(ConvertTo-PpbPyLiteral $_.Source)), $(ConvertTo-PpbPyLiteral $_.DestinationDir))" })
    $hidden = @($HiddenImports | Sort-Object -Unique | ForEach-Object { ConvertTo-PpbPyLiteral $_ })
    $pathex = @($PathEx | ForEach-Object { "P($(ConvertTo-PpbPyLiteral $_))" })
    $meta = @($MetadataDistributions | Sort-Object -Unique | ForEach-Object { ConvertTo-PpbPyLiteral $_ })
    $collect = @($CollectPackages | Sort-Object -Unique | ForEach-Object { ConvertTo-PpbPyLiteral $_ })
    $console = if ($Context.Windowed) { 'False' } else { 'True' }
    $icon = if ($IconFile) { "[os.path.join(SPECPATH, $(ConvertTo-PpbPyLiteral (Split-Path -Leaf $IconFile)))]" } else { 'None' }
    $name = ConvertTo-PpbPyLiteral $Context.Name

    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine('# -*- mode: python ; coding: utf-8 -*-')
    [void]$sb.AppendLine("# Generated by PythonPortableBuilder $($Context.ToolkitVersion) for '$($Context.Name)' ($($Context.Mode)).")
    [void]$sb.AppendLine('# Paths are relative to this file (SPECPATH). The staged sources live in ..\.build\stage and are')
    [void]$sb.AppendLine('# recreated by build.ps1/rebuild.ps1. To customise, copy this file and pass it with -SpecFile.')
    [void]$sb.AppendLine('import os')
    [void]$sb.AppendLine('from PyInstaller.utils.hooks import collect_submodules, copy_metadata')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine("STAGE = os.path.normpath(os.path.join(SPECPATH, $(ConvertTo-PpbPyLiteral $relStage)))")
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('def P(relative):')
    [void]$sb.AppendLine('    return os.path.normpath(os.path.join(STAGE, relative))')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine("datas = $(ConvertTo-PpbPyList $datas)")
    [void]$sb.AppendLine("hiddenimports = $(ConvertTo-PpbPyList $hidden)")
    [void]$sb.AppendLine("for _dist in $(ConvertTo-PpbPyList $meta):")
    [void]$sb.AppendLine('    try:')
    [void]$sb.AppendLine('        datas += copy_metadata(_dist)')
    [void]$sb.AppendLine('    except Exception as _exc:  # metadata is optional for many packages')
    [void]$sb.AppendLine("        print('PPB-WARNING: package metadata not copied for %s: %s' % (_dist, _exc))")
    [void]$sb.AppendLine("for _pkg in $(ConvertTo-PpbPyList $collect):")
    [void]$sb.AppendLine('    hiddenimports += collect_submodules(_pkg)')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('a = Analysis(')
    [void]$sb.AppendLine("    [os.path.normpath(os.path.join(SPECPATH, $(ConvertTo-PpbPyLiteral $relScript)))],")
    [void]$sb.AppendLine("    pathex=$(ConvertTo-PpbPyList $pathex 8),")
    [void]$sb.AppendLine('    binaries=[],')
    [void]$sb.AppendLine('    datas=datas,')
    [void]$sb.AppendLine('    hiddenimports=hiddenimports,')
    [void]$sb.AppendLine('    hookspath=[],')
    [void]$sb.AppendLine('    hooksconfig={},')
    [void]$sb.AppendLine('    runtime_hooks=[],')
    [void]$sb.AppendLine('    excludes=[],')
    [void]$sb.AppendLine('    noarchive=False,')
    [void]$sb.AppendLine(')')
    [void]$sb.AppendLine('pyz = PYZ(a.pure)')
    [void]$sb.AppendLine('')
    if ($Context.Mode -eq 'onefile') {
        [void]$sb.AppendLine('exe = EXE(')
        [void]$sb.AppendLine('    pyz, a.scripts, a.binaries, a.datas, [],')
        [void]$sb.AppendLine("    name=$name,")
        [void]$sb.AppendLine('    debug=False, bootloader_ignore_signals=False, strip=False, upx=False, upx_exclude=[],')
        [void]$sb.AppendLine("    runtime_tmpdir=None, console=$console, disable_windowed_traceback=False, argv_emulation=False,")
        [void]$sb.AppendLine("    target_arch=None, codesign_identity=None, entitlements_file=None, icon=$icon,")
        [void]$sb.AppendLine(')')
    } else {
        [void]$sb.AppendLine('exe = EXE(')
        [void]$sb.AppendLine('    pyz, a.scripts, [],')
        [void]$sb.AppendLine('    exclude_binaries=True,')
        [void]$sb.AppendLine("    name=$name,")
        [void]$sb.AppendLine('    debug=False, bootloader_ignore_signals=False, strip=False, upx=False,')
        [void]$sb.AppendLine("    console=$console, disable_windowed_traceback=False, argv_emulation=False,")
        [void]$sb.AppendLine("    target_arch=None, codesign_identity=None, entitlements_file=None, icon=$icon,")
        [void]$sb.AppendLine(')')
        [void]$sb.AppendLine("coll = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, upx_exclude=[], name=$name)")
    }
    Write-PpbTextFile -Path $SpecPath -Content $sb.ToString()
}

function Get-PpbRelativePathAny {
    <# Relative path from BasePath to Path (both absolute, same drive), e.g. '..\.build\stage\app'. #>
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$BasePath)
    $p = (Resolve-PpbPath $Path).Split('\')
    $b = (Resolve-PpbPath $BasePath).Split('\')
    if ($p[0] -ne $b[0]) { Stop-PpbWithError "Cannot express '$Path' relative to '$BasePath' (different drives)." }
    $i = 0
    while ($i -lt $p.Count -and $i -lt $b.Count -and [string]::Equals($p[$i], $b[$i], [StringComparison]::OrdinalIgnoreCase)) { $i++ }
    $parts = @()
    for ($j = $i; $j -lt $b.Count; $j++) { $parts += '..' }
    for ($j = $i; $j -lt $p.Count; $j++) { $parts += $p[$j] }
    if (-not $parts.Count) { return '.' }
    return ($parts -join '\')
}

<#
.SYNOPSIS
    Parses PyInstaller's warn-<name>.txt and returns missing modules imported at top level.
#>
function Get-PpbPyInstallerWarnings {
    param([Parameter(Mandatory)][string]$WarnFile, [string[]]$LocalTopLevel)
    $important = @(); $total = 0
    if (-not (Test-Path -LiteralPath $WarnFile)) { return @{ Total = 0; Important = @() } }
    foreach ($line in [System.IO.File]::ReadAllLines($WarnFile)) {
        if ($line -notmatch '^missing module named (\S+) - imported by (.+)$') { continue }
        $total++
        $mod = $Matches[1]; $by = $Matches[2]
        $importers = $by -split ',\s*'
        $topLevelLocal = @($importers | Where-Object {
                $_ -match '\(top-level\)' -and ($LocalTopLevel -contains (($_ -split '[\s.]')[0]))
            })
        if ($topLevelLocal.Count) { $important += "$mod (imported by $($topLevelLocal -join ', '))" }
    }
    return @{ Total = $total; Important = $important }
}

<#
.SYNOPSIS
    Builds the executable distribution described by the build context.
#>
function Invoke-PpbExecutableBuild {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Context)
    $ctx = $Context
    $cfg = $ctx.Config
    $report = $ctx.Report
    $entry = $ctx.Entry
    $dist = $ctx.DistDir
    $work = $ctx.WorkDir
    $target = $ctx.PythonTarget
    $base = $target.BuildPython

    # 1. Stage sources ---------------------------------------------------------
    Write-PpbLog 'Staging application files' -Level Step
    $stageRoot = Join-Path $work 'stage'
    if (Test-Path -LiteralPath $stageRoot) { Remove-PpbItem -Path $stageRoot -OwnerRoot $ctx.PackageDir }
    $stageApp = Join-Path $stageRoot 'app'
    Copy-PpbProjectFiles -Files $ctx.Selection.Included -Destination $stageApp
    foreach ($df in $ctx.DataFiles) {
        $destDir = if ($df.Destination -eq '.') { $stageApp } else { Join-Path $stageApp $df.Destination.Replace('/', '\') }
        New-PpbDirectory $destDir | Out-Null
        Copy-Item -LiteralPath $df.Source -Destination $destDir -Recurse -Force
    }
    Write-PpbLog ("Staged {0} file(s)" -f @($ctx.Selection.Included).Count) -Level Success

    # 2. Build environment -----------------------------------------------------
    Write-PpbLog 'Creating the isolated build environment' -Level Step
    $venvDir = Join-Path $work 'venv'
    $reqHash = if ($ctx.Requirements.File) { Get-PpbFileSha256 $ctx.Requirements.File } else { 'none' }
    $stamp = [ordered]@{ python = [string]$base.version; executable = [string]$base.executable; requirements = $reqHash; pyinstaller = [string]$cfg['pyinstallerRequirement']; purpose = 'pyinstaller' }
    $stampPath = Join-Path $venvDir '.ppb-env.json'
    $stampJson = ConvertTo-Json -InputObject $stamp -Depth 8 -Compress
    $fresh = $ctx.Clean -or -not (Test-Path -LiteralPath $stampPath) -or ([System.IO.File]::ReadAllText($stampPath).Trim() -ne $stampJson)
    $venvPy = New-PpbBuildEnvironment -BasePython ([string]$base.executable) -Path $venvDir -OwnerRoot $ctx.PackageDir -Stamp $stamp -UpgradePip:([bool]$cfg['upgradeBuildPip']) -Force:$fresh
    $sitePackages = Join-Path $venvDir 'Lib\site-packages'
    $appInventoryPath = Join-Path $venvDir 'ppb-app-inventory.json'
    if ($fresh -or -not (Test-Path -LiteralPath $appInventoryPath)) {
        $baseline = Get-PpbDependencyInventory -PythonExe $venvPy -Path $sitePackages -Version $target.Version -Architecture $ctx.Architecture
        $baseNames = @(@($baseline.distributions) | ForEach-Object { $_.name.ToLowerInvariant() })
        if ($ctx.Requirements.File) {
            Install-PpbRequirements -PythonExe $venvPy -RequirementsFile $ctx.Requirements.File -ReportFile (Join-Path $work 'pip-report.json') -TimeoutSeconds ([int]$cfg['timeouts']['pipSeconds'])
        }
        $after = Get-PpbDependencyInventory -PythonExe $venvPy -Path $sitePackages -Version $target.Version -Architecture $ctx.Architecture
        $appDists = @(@($after.distributions) | Where-Object { $baseNames -notcontains $_.name.ToLowerInvariant() })
        $appInventory = [ordered]@{ path = 'venv'; distributions = $appDists; pthFiles = @($after.pthFiles) }
        Install-PpbRequirements -PythonExe $venvPy -Packages @([string]$cfg['pyinstallerRequirement']) -TimeoutSeconds ([int]$cfg['timeouts']['pipSeconds'])
        Write-PpbJsonFile -Path $appInventoryPath -Data $appInventory
    } else {
        Write-PpbLog 'Dependencies unchanged since the previous build; reusing the environment.' -Level Info
    }
    $inventory = Read-PpbJsonFile $appInventoryPath
    foreach ($d in @($inventory.distributions)) { Write-PpbLog ("  {0} {1}" -f $d.name, $d.version) -Level Info }
    $pyiVersion = (Invoke-PpbProcess -FilePath $venvPy -ArgumentList @('-c', 'import PyInstaller; print(PyInstaller.__version__)') -Quiet -TimeoutSeconds 120).StdOut.Trim()
    if (-not $pyiVersion) { Stop-PpbWithError 'PyInstaller is not importable in the build environment.' }
    Write-PpbLog "PyInstaller $pyiVersion, Python $($base.version) [$($base.architecture)]" -Level Success

    $compat = Get-PpbBinaryCompatibility -Inventory $inventory -NativeReport $null -Architecture $ctx.Architecture
    if ($compat.Incompatible.Count) { Stop-PpbWithError ("Binary-incompatible packages:`n    " + ($compat.Incompatible -join "`n    ")) }

    # 3. Import resolution -----------------------------------------------------
    $thirdParty = @(@($report.imports.thirdParty) | ForEach-Object { $_ })
    $required = @($thirdParty | Where-Object { -not $_.optional } | ForEach-Object { $_.name })
    $missing = @(Test-PpbImportResolution -PythonExe $venvPy -Names $required)
    if ($missing.Count) {
        $msg = "Imports not resolvable in the build environment: $($missing -join ', '). Add the missing distributions to the requirements."
        if ($ctx.AllowUnresolvedImports) { Write-PpbLog $msg -Level Warn } else { Stop-PpbWithError ($msg + ' (Use -AllowUnresolvedImports to accept this deliberately.)') 2 }
    } elseif ($required.Count) { Write-PpbLog "All $($required.Count) required third-party import(s) resolve" -Level Success }

    # 4. Spec file ---------------------------------------------------------------
    Write-PpbLog 'Preparing the PyInstaller spec file' -Level Step
    $pyiDir = New-PpbDirectory (Join-Path $ctx.PackageDir 'pyinstaller')
    $resources = @(Get-PpbResourceFiles -Files $ctx.Selection.Included)
    foreach ($df in $ctx.DataFiles) {
        $leafRoot = if ($df.Destination -eq '.') { '' } else { $df.Destination + '/' }
        if (Test-Path -LiteralPath $df.Source -PathType Container) {
            Get-ChildItem -LiteralPath $df.Source -Recurse -File | ForEach-Object {
                $resources += ($leafRoot + (Split-Path -Leaf $df.Source) + '/' + (Get-PpbRelativePath -Path $_.FullName -BasePath $df.Source).Replace('\', '/'))
            }
        } else { $resources += ($leafRoot + (Split-Path -Leaf $df.Source)) }
    }
    $importRoots = @($report.importRoots)
    $dataMap = @(Get-PpbBundleDataMap -Resources $resources -ImportRoots $importRoots)
    $bundled = @($dataMap | ForEach-Object { $_.BundlePath })

    if ($ctx.SpecFile) {
        $specPath = Resolve-PpbPath $ctx.SpecFile -BasePath $ctx.ProjectRoot
        if (-not (Test-Path -LiteralPath $specPath)) { Stop-PpbWithError "Spec file not found: $specPath" 2 }
        $copy = Join-Path $pyiDir (Split-Path -Leaf $specPath)
        if (-not (Test-PpbPathEqual $copy $specPath)) { Copy-Item -LiteralPath $specPath -Destination $copy -Force }
        Write-PpbLog "Using custom spec file $specPath (a copy is kept in pyinstaller\)" -Level Info
        $bundled = @()
    } else {
        $specPath = Join-Path $pyiDir "$($ctx.Name).spec"
        $pathex = @($importRoots | ForEach-Object { if ($_ -eq '.' -or -not $_) { '.' } else { $_ } })
        foreach ($p in $ctx.AdditionalPaths) { $pathex += $p.Replace('\', '/') }
        $hidden = New-Object System.Collections.Generic.List[string]
        foreach ($m in @($report.localModules)) {
            if ($m -match '(^|\.)(tests?|testing|conftest|setup)(\.|$)' -or $m -match '(^|\.)test_') { continue }
            $hidden.Add($m)
        }
        foreach ($d in @($report.dynamicImports)) { if ($d.module -and $d.module -notmatch '^\.') { $hidden.Add([string]$d.module) } }
        foreach ($h in $ctx.HiddenImports) { $hidden.Add($h) }
        $freeze = @($report.imports.stdlib) -contains 'multiprocessing'
        if ($entry.kind -eq 'script') {
            $scriptPath = Join-Path $stageApp ([string]$entry.path).Replace('/', '\')
            $scriptDir = Split-Path -Parent ([string]$entry.path).Replace('\', '/')
            if ($scriptDir -and ($pathex -notcontains $scriptDir)) {
                $pathex += $scriptDir
                Write-PpbLog "Entry script is in '$scriptDir'; resources it locates via __file__ are resolved relative to the bundle root, not '$scriptDir'." -Level Warn
            }
            if ($freeze) { Write-PpbLog 'multiprocessing is used: make sure the entry script calls multiprocessing.freeze_support().' -Level Warn }
        } else {
            $scriptPath = Join-Path $stageRoot 'ppb_entry.py'
            New-PpbEntryBootstrap -Entry $entry -Path $scriptPath -FreezeSupport:$freeze
            $hidden.Add([string]$entry.module)
            if ($entry.kind -eq 'module') { $hidden.Add("$($entry.module).__main__") }
        }
        $metaDists = @(@($inventory.distributions) | ForEach-Object { $_.name })
        $icon = $null
        if ($ctx.Icon) {
            $iconSrc = Resolve-PpbPath $ctx.Icon -BasePath $ctx.ProjectRoot
            if (-not (Test-Path -LiteralPath $iconSrc)) { Stop-PpbWithError "Icon file not found: $iconSrc" 2 }
            $icon = Join-Path $pyiDir (Split-Path -Leaf $iconSrc)
            Copy-Item -LiteralPath $iconSrc -Destination $icon -Force
        }
        New-PpbPyInstallerSpec -Context $ctx -SpecPath $specPath -StageAppDir $stageApp -ScriptPath $scriptPath -DataMap $dataMap `
            -HiddenImports @($hidden | Select-Object -Unique) -PathEx $pathex -MetadataDistributions $metaDists -CollectPackages @($ctx.CollectPackages) -IconFile $icon
        Write-PpbLog "Spec file: $specPath" -Level Success
    }

    # 5. PyInstaller -------------------------------------------------------------
    Write-PpbLog "Running PyInstaller ($($ctx.Mode))" -Level Step
    $pyiDist = Join-Path $work 'pyi-dist'
    $pyiWork = Join-Path $work 'pyi-work'
    foreach ($d in $pyiDist, $pyiWork) { if (Test-Path -LiteralPath $d) { Remove-PpbItem -Path $d -OwnerRoot $ctx.PackageDir } }
    $pyiArgs = @('-m', 'PyInstaller', '--noconfirm', '--clean', '--distpath', $pyiDist, '--workpath', $pyiWork)
    if (Test-PpbVerboseLogging) { $pyiArgs += @('--log-level', 'INFO') } else { $pyiArgs += @('--log-level', 'WARN') }
    $pyiArgs += $specPath
    $pyiEnv = Get-PpbIsolatedPipEnvironment
    $r = Invoke-PpbProcess -FilePath $venvPy -ArgumentList $pyiArgs -WorkingDirectory $pyiDir -Environment $pyiEnv -TimeoutSeconds ([int]$cfg['timeouts']['pyinstallerSeconds'])
    $pyiLog = Join-Path $pyiDir 'pyinstaller-output.log'
    Write-PpbTextFile -Path $pyiLog -Content (Protect-PpbText ($r.StdOut + "`n" + $r.StdErr))
    if ($r.ExitCode -ne 0) {
        $tail = (($r.StdErr.Trim() -split "`r?`n") | Select-Object -Last 30) -join "`n    "
        Stop-PpbWithError "PyInstaller failed (exit $($r.ExitCode)). Full output: $pyiLog`n    $tail"
    }
    foreach ($l in ($r.StdErr -split "`r?`n")) { if ($l -match '\b(WARNING|ERROR)\b|PPB-WARNING') { Write-PpbLog "PyInstaller: $($l.Trim())" -Level Warn } }

    $specName = [System.IO.Path]::GetFileNameWithoutExtension($specPath)
    $warnFile = Get-ChildItem -LiteralPath $pyiWork -Recurse -Filter 'warn-*.txt' -ErrorAction SilentlyContinue | Select-Object -First 1
    $warnings = @{ Total = 0; Important = @() }
    if ($warnFile) {
        Copy-Item -LiteralPath $warnFile.FullName -Destination $pyiDir -Force
        $warnings = Get-PpbPyInstallerWarnings -WarnFile $warnFile.FullName -LocalTopLevel @($report.localTopLevel)
        Write-PpbLog ("PyInstaller reported {0} missing optional/conditional module(s); details in pyinstaller\{1}" -f $warnings.Total, $warnFile.Name) -Level Info
        foreach ($w in $warnings.Important) { Write-PpbLog "Missing module imported at top level by the application: $w" -Level Warn }
    }

    # 6. Collect output ------------------------------------------------------------
    if ($ctx.Mode -eq 'onefile') {
        $exe = Get-ChildItem -LiteralPath $pyiDist -Filter '*.exe' -File | Select-Object -First 1
        if (-not $exe) { Stop-PpbWithError "PyInstaller produced no executable in $pyiDist" }
        Copy-Item -LiteralPath $exe.FullName -Destination (Join-Path $dist "$($ctx.Name).exe") -Force
    } else {
        $folder = Join-Path $pyiDist $specName
        if (-not (Test-Path -LiteralPath $folder)) { $folder = (Get-ChildItem -LiteralPath $pyiDist -Directory | Select-Object -First 1).FullName }
        if (-not $folder -or -not @(Get-ChildItem -LiteralPath $folder -Filter '*.exe' -File).Count) { Stop-PpbWithError "PyInstaller onedir output not found in $pyiDist" }
        Get-ChildItem -LiteralPath $folder -Force | Copy-Item -Destination $dist -Recurse -Force
        $exe = Get-ChildItem -LiteralPath $dist -Filter '*.exe' -File | Select-Object -First 1
        if ($exe.BaseName -ne $ctx.Name) { Rename-Item -LiteralPath $exe.FullName -NewName "$($ctx.Name).exe" }
    }
    $exePath = Join-Path $dist "$($ctx.Name).exe"
    Write-PpbLog ("Executable: {0} ({1:N1} MB)" -f $exePath, ((Get-Item -LiteralPath $exePath).Length / 1MB)) -Level Success

    $native = $null
    if ($ctx.Mode -eq 'onedir') { $native = Get-PpbNativeDependencyReport -PythonExe $venvPy -Root $dist }
    else { $native = Get-PpbNativeDependencyReport -PythonExe $venvPy -Root $dist -SearchDirectories @($sitePackages, [string]$base.basePrefix, (Join-Path ([string]$base.basePrefix) 'DLLs')) }

    $requiredFiles = @("$($ctx.Name).exe", 'verify.ps1', 'README.md', 'DEPLOYMENT.md')
    if ($ctx.Mode -eq 'onedir') { $requiredFiles += '_internal' }
    return @{
        Runtime          = [ordered]@{ source = "PyInstaller $pyiVersion bundling the build interpreter (Python $($base.version), $($base.architecture))"; sha256 = $null; checksumVerified = $null }
        Inventory        = $inventory
        NativeReport     = $native
        ImportNames      = @()
        MissingImports   = $missing
